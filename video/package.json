{
  "name": "padelduel-video",
  "private": true,
  "description": "Uitlegvideo PadelDuel (Remotion). Los van de Next-app.",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render src/index.ts PadelDuelUitlegV3 out/padelduel-uitleg-v3.mp4",
    "render:v1": "remotion render src/index.ts PadelDuelUitleg out/padelduel-uitleg.mp4",
    "music": "cd music && python3 compose.py && python3 compose.py v3 && python3 compose.py social",
    "render:social": "remotion render src/index.ts PadelDuelSocialV3 out/padelduel-social-v3.mp4",
    "render:v2": "remotion render src/index.ts PadelDuelUitlegV2 out/padelduel-uitleg-v2.mp4",
    "voice": "cd voice && python3 generate.py"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.545",
    "@remotion/google-fonts": "^4.0.545",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.545",
    "typescript": "^5.9.3"
  }
}
