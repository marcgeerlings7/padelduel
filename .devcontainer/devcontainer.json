{
  "name": "Padel Ladder",
  // Expliciete Node 20-image i.p.v. `universal:2`: die herstartte niet meer
  // ("unable to find user codespace") waardoor Codespaces steeds in een
  // kale Alpine-recovery-container eindigde (geen node/docker/postgres).
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bookworm",
  "remoteUser": "node",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [3000, 5432],
  "portsAttributes": {
    "3000": {
      "label": "Padel Ladder (dev)",
      "onAutoForward": "notify"
    },
    "5432": {
      "label": "Postgres (dev db)",
      "onAutoForward": "silent"
    }
  },
  "postStartCommand": "bash .devcontainer/start.sh"
}
