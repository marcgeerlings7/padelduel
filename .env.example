DATABASE_URL="postgresql://padel:padel@localhost:5432/padel_ladder_dev?schema=public"
JWT_SECRET="change-me-to-a-random-secret"
APP_BASE_URL="http://localhost:3000"
JOBS_SECRET="change-me-to-a-random-secret"

# Alleen nodig op Vercel (niet lokaal): moet EXACT gelijk zijn aan
# JOBS_SECRET. Vercel Cron stuurt deze automatisch mee als
# "Authorization: Bearer $CRON_SECRET" bij het aanroepen van de
# jobs in vercel.json. Zie docs/Technical_Debt.md ("Vercel-deploy").
CRON_SECRET="change-me-to-a-random-secret"

# E-mailverzending via Resend (https://resend.com). Leeg laten = dev-fallback:
# activatiemails worden dan alleen naar de serverconsole gelogd (lokaal/QA).
# Op Vercel/productie zetten, anders ontvangen gebruikers geen activatiemail.
# Zie src/lib/auth/email.ts en docs/Technical_Debt.md ("Post-v1").
RESEND_API_KEY=""
# Afzender van de mails. Moet een bij Resend geverifieerd domein gebruiken;
# default (als leeg) is "Padel Ladder <onboarding@resend.dev>" — het
# Resend-testadres, dat alleen naar het e-mailadres van je eigen
# Resend-account kan versturen.
EMAIL_FROM=""
